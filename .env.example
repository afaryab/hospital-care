APP_NAME="Medical OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
ENABLE_OLD_SYNC=false

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# CACHE_STORE=redis is set via docker-compose.yml's app/cli services — this
# default only applies outside Docker, where no Redis server is assumed.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TELESCOPE_ENABLED=false

MAX_USERS_ALLOWED=10
MAX_PATIENTS_ALLOWED=1000
MAX_PAYMENTS_ALLOWED=10000

# Document Management System — self-hosted OnlyOffice Document Server for
# in-browser Word/Excel/PowerPoint editing. ONLYOFFICE_INTERNAL_URL is how
# Laravel (and the Document Server itself) reach the container over the
# internal Docker network; the browser reaches the same container through
# this app's own nginx proxy at ONLYOFFICE_PUBLIC_PATH (see
# docker/app/default.conf). JWT_SECRET must match the documentserver
# service's JWT_SECRET in docker-compose.yml.
ONLYOFFICE_INTERNAL_URL=http://onlyoffice-documentserver
ONLYOFFICE_PUBLIC_PATH=/onlyoffice
ONLYOFFICE_JWT_SECRET=

# HIPAA/PHC compliance expects MFA on admin/accountant accounts — defaults
# to enforced (see config/security.php). Set to false only for environments
# where the 2FA setup step is genuinely unwanted (e.g. local development).
# SECURITY_ENFORCE_TWO_FACTOR=true

# Database backups (spatie/laravel-backup, config/backup.php) contain full
# patient/financial records — HIPAA/PHC compliance requires them encrypted
# at rest. REQUIRED in production: backup:run refuses to run in production
# (APP_ENV=production) unless this is set. Generate with, e.g.,
# `php artisan tinker --execute "echo Str::random(32);"` and store it
# somewhere separate from this file (a secrets manager, not version
# control) — losing it makes existing backups unrecoverable.
BACKUP_ARCHIVE_PASSWORD=
# Retention (HIPAA/PHC minimum is 6 years) and the storage ceiling cleanup
# won't exceed to get there — see config/backup.php for the full rationale.
# Defaults (6 years, 20000MB) are already compliant; only override with a
# documented reason.
BACKUP_KEEP_YEARLY_YEARS=6
BACKUP_MAX_STORAGE_MEGABYTES=20000